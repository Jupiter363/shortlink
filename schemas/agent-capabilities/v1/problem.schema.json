{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shortlink.example/agent-capabilities/v1/problem.schema.json",
  "title": "Agent Capability Problem v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "code",
    "detail",
    "instance",
    "requestId",
    "retryable",
    "violations"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{1,64}$"
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "instance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "traceId": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "retryable": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "maxItems": 32
    }
  }
}
