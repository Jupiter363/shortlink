{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shortlink.example/agent-capabilities/v1/short-links-query-response.schema.json",
  "title": "Short Links Query Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "snapshot", "data", "warnings"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "source", "observedAt", "expiresAt", "contentHash"],
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^snap-[A-Za-z0-9_-]{1,128}$"
        },
        "source": {
          "const": "admin/short-links"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gid",
        "current",
        "size",
        "total",
        "pages",
        "hasNext",
        "sort",
        "records"
      ],
      "properties": {
        "gid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "current": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hasNext": {
          "type": "boolean"
        },
        "sort": {
          "enum": [
            "CREATED_AT_DESC",
            "TODAY_PV_DESC",
            "TODAY_UV_DESC",
            "TODAY_UIP_DESC",
            "TOTAL_PV_DESC",
            "TOTAL_UV_DESC",
            "TOTAL_UIP_DESC"
          ]
        },
        "records": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/shortLink"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  },
  "$defs": {
    "shortLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullShortUrl",
        "describe",
        "validity",
        "expiresAt",
        "createdAt",
        "todayPv",
        "todayUv",
        "todayUip",
        "totalPv",
        "totalUv",
        "totalUip"
      ],
      "properties": {
        "fullShortUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$"
        },
        "describe": {
          "type": ["string", "null"],
          "maxLength": 1024
        },
        "validity": {
          "enum": ["PERMANENT", "CUSTOM"]
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "todayPv": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "todayUv": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "todayUip": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "totalPv": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "totalUv": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "totalUip": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validity": {
                "const": "PERMANENT"
              }
            }
          },
          "then": {
            "properties": {
              "expiresAt": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    }
  }
}
