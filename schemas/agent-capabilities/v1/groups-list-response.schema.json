{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shortlink.example/agent-capabilities/v1/groups-list-response.schema.json",
  "title": "Groups List Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "snapshot", "data", "warnings"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "source", "observedAt", "expiresAt", "contentHash"],
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^snap-[A-Za-z0-9_-]{1,128}$"
        },
        "source": {
          "const": "admin/groups"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "data": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gid", "name", "sortOrder", "shortLinkCount"],
        "properties": {
          "gid": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sortOrder": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "shortLinkCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  }
}
