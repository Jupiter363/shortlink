{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shortlink.example/agent-capabilities/v1/group-stats-query-request.schema.json",
  "title": "Group Stats Query Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["gid", "timeRange"],
  "properties": {
    "gid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}
