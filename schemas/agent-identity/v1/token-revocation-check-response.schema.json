{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shortlink.example/agent-identity/v1/token-revocation-check-response.schema.json",
  "title": "Agent Token Revocation Check Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["active", "sessionId", "grantVersion", "tokenId", "checkedAt"],
  "properties": {
    "active": {"type": "boolean"},
    "sessionId": {"type": "string", "pattern": "^as-s-[A-Za-z0-9_-]{1,123}$"},
    "grantVersion": {"type": "integer", "minimum": 1},
    "tokenId": {"type": "string", "pattern": "^adt-[A-Za-z0-9_-]{1,128}$"},
    "checkedAt": {"type": "string", "format": "date-time"},
    "reasonCode": {
      "enum": [
        "SESSION_NOT_FOUND", "SESSION_REVOKED", "SESSION_EXPIRED",
        "GRANT_VERSION_MISMATCH", "TOKEN_REVOKED", "TOKEN_NOT_CURRENT"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"active": {"const": false}}},
      "then": {"required": ["reasonCode"]}
    },
    {
      "if": {"properties": {"active": {"const": true}}},
      "then": {"not": {"required": ["reasonCode"]}}
    }
  ]
}
